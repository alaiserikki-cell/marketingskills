# Copy this file to .env and fill in your keys. .env is git-ignored.

# Required: free key(s) from https://aistudio.google.com/apikey — comma-separate several to rotate on rate limits
GEMINI_API_KEYS=

# Optional: pin a model. Leave blank to auto-pick the newest available "flash" model.
GEMINI_MODEL=

# Optional but recommended: Neon Postgres connection string (Neon dashboard -> Connect).
# Leave blank to store data in ./data/store.json instead.
DATABASE_URL=

# Optional: YouTube Data API v3 key (Google Cloud console, free 10,000 units/day).
YOUTUBE_API_KEY=

PORT=3300
